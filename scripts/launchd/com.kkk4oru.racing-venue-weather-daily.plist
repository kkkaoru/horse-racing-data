<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent: daily Cloudflare R2 SQL weather synchronization.

  Runs at JST 06:00 every day after the 01:30 Cloudflare forecast cron.
  Synchronizes the latest seven days from the stable v1 and additive v2
  Cloudflare Pipeline tables into apps/venue-weather/data yearly DuckDB files.

  Covers 25 venues: 10 JRA (01–10) + 15 NAR/Ban'ei (30,35,36,42–48,50,51,54,55,83).

  Install:
    cp com.kkk4oru.racing-venue-weather-daily.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.kkk4oru.racing-venue-weather-daily.plist

  Credentials are read at runtime from the repository root .env without being
  stored in this plist.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kkk4oru.racing-venue-weather-daily</string>

  <key>Program</key>
  <string>/Users/kkk4oru/ghq/github.com/kkkaoru/horse-racing-data/scripts/launchd/racing-venue-weather-daily.sh</string>

  <key>WorkingDirectory</key>
  <string>/Users/kkk4oru/ghq/github.com/kkkaoru/horse-racing-data</string>

  <!-- JST 06:00 daily — after the Worker forecast cron and before race serving. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/kkk4oru/Library/Logs/racing-venue-weather/launchd-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/kkk4oru/Library/Logs/racing-venue-weather/launchd-stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
