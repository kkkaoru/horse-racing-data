{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pipeline-health-monitor",
  "main": "src/index.ts",
  "account_id": "78109ec18c7c85b194b19fb32e3bb149",
  "compatibility_date": "2026-05-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  // Every 5 min for the queue-delivery canary; readiness and existing checks
  // remain quarter-hourly in scheduled-handler.ts (JST 09:00–22:55 = UTC 00–13).
  "triggers": {
    "crons": ["*/5 0-13 * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "ALERT_QUEUE",
        "queue": "pipeline-health-alerts",
      },
    ],
    "consumers": [
      {
        "queue": "pipeline-health-alerts",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 3,
      },
    ],
  },
  "services": [
    {
      "binding": "REALTIME",
      "service": "sync-realtime-data",
    },
    {
      "binding": "FINISH_POSITION_CRON",
      "service": "finish-position-cron",
    },
  ],
  // Operator must run:
  //   wrangler kv namespace create pipeline-health-monitor-state
  // then replace `REPLACE_WITH_KV_ID` below with the returned `id` value.
  "kv_namespaces": [
    {
      "binding": "STATE_KV",
      "id": "512eb391768544eb9184f930fb6c0f3e",
    },
  ],
}
