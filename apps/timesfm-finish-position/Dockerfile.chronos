# Optional isolated CPU service; never changes the active prediction image.
# Build with this package as context and --platform linux/amd64.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS dependencies
COPY --from=ghcr.io/astral-sh/uv:0.9.26@sha256:9a23023be68b2ed09750ae636228e903a54a05ea56ed03a934d00fe9fbeded4b /uv /usr/local/bin/uv
COPY requirements-chronos-cpu.txt /requirements.txt
RUN uv pip install --system --no-cache --require-hashes -r /requirements.txt

FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HOME=/app/cache \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1
WORKDIR /app
COPY --from=dependencies /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY src/timesfm_finish_position /app/timesfm_finish_position
RUN python -c "import importlib.util; assert importlib.util.find_spec('mlx') is None; assert importlib.util.find_spec('timesfm_finish_position.chronos_mlx_training') is None; from timesfm_finish_position.chronos_service import main"
USER 10001:10001
EXPOSE 8080
CMD ["python", "-m", "timesfm_finish_position.chronos_service"]
