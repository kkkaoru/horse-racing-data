{
  "name": "finish-position-cron",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "(cd ../finish-position-predict-container && bun run artifact:verify -- --artifact-root models --system finish-position) && ../../scripts/ensure-docker-compat.sh -- sh -c 'bun run d1:migrate && bun scripts/deploy-with-queue-drain.ts'",
    "deploy:model": "REQUEUE_FINISH_POSITION_PREDICTIONS=1 bun run deploy",
    "dev": "../../scripts/ensure-docker-compat.sh -- wrangler dev",
    "d1:migrate": "./scripts/d1-migrate-with-retry.sh",
    "d1:migrate:local": "wrangler d1 migrations apply finish-position-cron-db --local",
    "format": "oxfmt --write src package.json tsconfig.json vitest.config.ts wrangler.jsonc",
    "format:check": "oxfmt --check src package.json tsconfig.json vitest.config.ts wrangler.jsonc",
    "lint": "oxlint . --tsconfig ./tsconfig.json --type-aware --import-plugin --node-plugin --promise-plugin --deny-warnings --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@neondatabase/serverless": "catalog:",
    "catboost-json-tree": "workspace:*",
    "hyparquet": "1.26.0",
    "xgboost-json-tree": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
