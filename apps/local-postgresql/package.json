{
  "name": "local-postgresql",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "./scripts/start.sh",
    "stop": "./scripts/stop.sh",
    "logs": "container inspect horse-racing-local-postgresql",
    "psql": "./scripts/psql.sh",
    "replica:create-subscription": "./scripts/create-neon-subscription.sh",
    "replica:push": "bun run indexes:repair:quick && bun run replica:push:r2-catalog && bun run replica:push:neon",
    "replica:push:neon": "bun run ./scripts/push-neon-sync.ts",
    "replica:push:r2-catalog": "bun run --env-file=../../.env --cwd ../pc-keiba-r2-catalog sync:full",
    "replica:status": "bun run ./scripts/push-neon-status.ts",
    "replica:watch": "bun run ./scripts/push-neon-status.ts --watch 10",
    "replica:tail-log": "tail -f tmp/push-neon-sync.log",
    "indexes:check": "bun run ./scripts/check-and-repair-indexes.ts",
    "indexes:check:quick": "bun run ./scripts/check-and-repair-indexes.ts --quick",
    "indexes:repair": "bun run ./scripts/check-and-repair-indexes.ts --repair",
    "indexes:repair:quick": "bun run ./scripts/check-and-repair-indexes.ts --repair --quick",
    "scrape:keiba-go": "python3 ./scripts/keiba_go_scrape_import.py",
    "status": "container list --all",
    "test": "vitest run && vitest run --config scripts/vitest.config.ts",
    "test:coverage": "vitest run --coverage && vitest run --config scripts/vitest.config.ts",
    "lint": "bunx oxlint",
    "format": "bunx oxfmt",
    "format:check": "bunx oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
