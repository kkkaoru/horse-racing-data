    "R2_SQL_BUCKET_NAME": "pc-keiba-r2-catalog",
    "R2_SQL_NAMESPACE": "pc_keiba",
    "CACHE_TTL_SECONDS": "60",
    "KV_TTL_SECONDS": "600",
  },
  // R2_SQL_TOKEN and ADMIN_TOKEN must be configured with `wrangler secret put`.
