{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pc-keiba-r2-catalog",
  "main": "src/index.ts",
  "account_id": "78109ec18c7c85b194b19fb32e3bb149",
  "compatibility_date": "2026-07-14",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
