{
  "name": "pc-keiba-r2-catalog",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "bunx wrangler deploy",
    "dev": "bunx wrangler dev",
    "format": "bunx oxfmt",
    "format:check": "bunx oxfmt --check",
    "lint": "bunx oxlint",
    "smoke:r2-sql": "bun run scripts/smoke-r2-sql.ts",
    "smoke:running-style": "bun run scripts/smoke-running-style-r2-sql.ts",
    "sync": "uv run scripts/sync_r2_catalog.py",
    "sync:full": "uv run scripts/sync_r2_catalog.py --full",
    "sync:test": "uv run scripts/test_sync_r2_catalog.py",
    "test": "bunx vitest run",
    "test:coverage": "bunx vitest run --coverage",
    "tsc": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
