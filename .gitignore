# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Python
__pycache__/
*.pyc
.coverage
.coverage.*
.pytest_cache/
.venv/
.ruff_cache/
*.egg-info/

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

.temp.md

# Wrangler
.wrangler/
.dev.vars
wrangler.deploy.toml

# Playwright test output
test-results/

# DuckDB WASM binary (copied from node_modules at build time)
*.wasm
*.xlsx

# DuckDB feature registries derived from paid source data (local build artifacts)
apps/pc-keiba-viewer/feature_registry*.duckdb*
apps/pc-keiba-viewer/trial_registry*.duckdb*

apps/**/tmp/**
tmp/
**/.tmp
apps/sync-realtime-data/running-style/

# wrangler r2 object get local downloads
apps/pc-keiba-viewer/finish-position/*
# Keep the v8 baked lookups (small static parquet, source of truth for runtime).
!apps/pc-keiba-viewer/finish-position/lookups/
catboost_info/

# Baked finish-position model artifacts staged into the container build context
# (gitignored scratch; pulled from apps/pc-keiba-viewer/tmp/models before deploy)
apps/finish-position-predict-container/models/

# MLflow local tracking/artifact stores (apps/mlflow, apps/mlflow-ui)
apps/mlflow/data/
# mlflow auto-creates its own "Default" experiment's artifact root as
# "<cwd>/mlruns" outside data/ whenever a fresh store's first touch happens
# with a different cwd than apps/mlflow/data (see cli.py's cmd_init).
apps/mlflow/mlruns/
# A stray sqlite db has ended up committed at the package root (instead of
# apps/mlflow/data/) more than once; ignore it (and its WAL sidecar files)
# outright so it can never be staged again.
apps/mlflow/mlflow.db*
apps/mlflow-ui/mlflow.db*

# Claude Code internal artifacts (worktrees, memory caches, etc.)
# skills/ だけはリポジトリで共有するため、ディレクトリ指定ではなくワイルドカードで除外する
.claude/*
!.claude/skills

# Serena local project artifacts (cache, memories, project.yml)
.serena/

# Probe runtime dumps written as NDJSON but named .json (oxfmt rejects them)
docs/probes/**/accept.json

tmp
.neon

temp/*
!temp/.gitignore
