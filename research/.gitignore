# Research is source-first: new output formats and experiment names are ignored.
# Traverse experiment directories so source files remain visible at any depth.
*
!*/
!.gitignore
!*.py
!*.pyi
!*.sh
!*.bash
!*.zsh
!*.ps1
!*.sql
!*.ts
!*.tsx
!*.js
!*.jsx
!*.mjs
!*.cjs
!*.rs
!*.go
!*.r
!*.R
!*.jl
!*.c
!*.h
!*.cpp
!*.hpp
!*.md
!*.mdx
!*.rst
!*.toml
!*.yaml
!*.yml
!*.ini
!*.cfg
!*.jsonc
!package.json
!tsconfig*.json
!requirements*.txt
!uv.lock
!bun.lock
!Cargo.lock
!go.mod
!go.sum
!Dockerfile
!Dockerfile.*
!Makefile
!.env.example

# Never expose generated/downloaded source inside runtime or test workspaces.
runtime/
node_modules/
.venv/
venv/
__pycache__/
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.git/
test-work-*/
test-full-*/
test-model-*/
