# shellcheck disable=all

# Cloudflare Account
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DOMAIN=""

# Non-secret HTTPS origin for `bun run prod login/get/url` (no trailing path).
# Access credentials stay in cloudflared's native cache, not this file.
PC_KEIBA_VIEWER_ORIGIN=""

# Cloudflare API Token (デフォルト / フォールバック用)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_R2_API_TOKEN=""
# Always enabled
LOG_REQUESTS="1"

# MLflow backend store (Neon Postgres `mlflow` database in the same project as
# NEON_PRIMARY_URL). Optional -- apps/mlflow and apps/mlflow-ui both fall back
# to the local sqlite file under apps/mlflow/data/ when unset.
HORSE_RACING_MLFLOW_BACKEND_URI=""
